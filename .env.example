# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: Optional MongoDB connection string for external MongoDB persistence.
# When omitted, LokSudhar persists records atomically in local JSON storage alongside Firestore.
MONGODB_URI=""

# ADMIN_PASSCODE: Optional server-side administrator passcode for the Admin Portal.
# When omitted, an inline first-run administrator claim setup is shown in the Admin Portal.
ADMIN_PASSCODE=""

# WORKER_PASSCODE: Optional server-side department/field officer passcode for the Department Portal.
# When omitted, an inline first-run field officer claim setup is shown in the Department Portal.
WORKER_PASSCODE=""
